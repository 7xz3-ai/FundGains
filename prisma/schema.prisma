// prisma/schema.prisma
// ApexYield Anonymous — Non-custodial staking platform on Base
// Identity = wallet address. Zero PII stored.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum TransactionType {
  DEPOSIT        // P2P inbound detected by Alchemy webhook
  WITHDRAWAL     // User withdraws to external address
  STAKE          // User deposits into a Vault
  UNSTAKE        // User exits a Vault position
  YIELD_CREDIT   // Cron-accrued yield credited to staked balance
  SWAP           // Token conversion via DEX aggregator
  REFERRAL_BONUS // Yield-share from tiered referral
}

enum BadgeType {
  MARKET_MASTER    // 5-day streak checking Happiness Chart
  FIRST_STAKE      // First-ever stake
  YIELD_HUNTER     // Earned 1000+ cents yield
  DIVERSIFIER      // Staked in 3+ different vaults
  SOCIAL_BUTTERFLY // Referred 3+ users
  WHALE            // Staked $10,000+
  DIAMOND_HANDS    // Staked for 30+ days
  SWAP_PRO         // Completed 10+ swaps
}

enum AlertType {
  YIELD_UPGRADE    // Better APY available elsewhere
  REBALANCE        // Portfolio too concentrated
  RISK_WARNING     // Vault risk score changed
  STREAK_REMINDER  // Daily streak about to break
  REFERRAL_EARNED  // Referral yield-share credited
  LEVEL_UP         // User leveled up
}

enum AssetCategory {
  CRYPTO
  RWA
  STABLE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
}

// ---------------------------------------------------------------------------
// USER
// walletAddress is the ONLY identity — no email, no name, no IP
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique // 0x... checksum address — THE identity
  ensName       String?          // fetched from ENS, cached here
  cyberAlias    String?          // generated alias from wallet hash
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Balances stored as BigInt cents (USD-equivalent) to avoid float rounding.
  // 100000 = $1,000.00
  cashBalance   BigInt @default(0)
  stakedBalance BigInt @default(0)

  // Optimistic locking — incremented on every balance mutation
  version Int @default(0)

  // Gamification
  xp    Int @default(0) // total experience points
  level Int @default(1) // derived from XP thresholds

  // Referral (tiered)
  referralCode  String?  @unique // unique code for sharing
  referredById  String?          // who referred this user
  referredBy    User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]   @relation("Referrals") // users this user referred

  // Relations
  transactions     Transaction[]
  stakedAssets     StakedAsset[]
  depositAddresses DepositAddress[]
  badges           UserBadge[]
  dailyStreaks     DailyStreak[]
  alerts           AIAlert[]
  swapHistory      SwapRecord[]
  referralEarnings ReferralEarning[] @relation("ReferralEarner")
  referralSources  ReferralEarning[] @relation("ReferralSource")
  profile          UserProfile?

  // Phase 8: Sovereign State
  proposals        Proposal[]  @relation("ProposalCreator")
  votes            Vote[]      @relation("Voter")
  contributions    LaunchpadContribution[] @relation("LaunchpadContributor")

  @@index([walletAddress])
  @@index([referralCode])
}

// ---------------------------------------------------------------------------
// TRANSACTION — top-level ledger event
// ---------------------------------------------------------------------------

model Transaction {
  id             String            @id @default(cuid())
  userId         String
  type           TransactionType
  status         TransactionStatus @default(PENDING)

  // Client generates a UUID per logical request.
  // @unique prevents duplicate processing on retries.
  idempotencyKey String @unique

  // All monetary values in BigInt cents (minor units)
  amountCents BigInt
  feeCents    BigInt @default(0)

  // For crypto operations
  assetSymbol      String?  // "ETH", "USDC"
  assetAmount      Decimal? @db.Decimal(28, 18) // token units, high precision
  priceAtTimeCents BigInt?  // USD-cents snapshot used for conversion

  // On-chain reference
  txHash String? // Base transaction hash once confirmed

  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user        User         @relation(fields: [userId], references: [id])
  stakedAsset StakedAsset? @relation(fields: [stakedAssetId], references: [id])
  stakedAssetId String?

  @@index([userId, status])
  @@index([status, createdAt]) // for cleanup cron scanning PENDING/PROCESSING
  @@index([idempotencyKey])
  @@index([txHash])
}

// ---------------------------------------------------------------------------
// STAKED ASSET — individual vault position
// ---------------------------------------------------------------------------

model StakedAsset {
  id          String @id @default(cuid())
  userId      String
  vaultId     String // on-chain vault contract address (Base)
  assetSymbol String // "ETH", "USDC", etc.
  category    AssetCategory @default(CRYPTO)

  amountStaked Decimal @db.Decimal(28, 18) // token units
  apyBps       Int     // APY in basis points (500 = 5.00%)
  principalCents BigInt // USD-cents value at time of staking

  accruedYieldCents BigInt   @default(0)
  stakedAt          DateTime @default(now())
  lastYieldAt       DateTime @default(now()) // timestamp of last yield accrual
  unstakedAt        DateTime? // null while active
  isActive          Boolean   @default(true)

  // Optimistic locking for yield accrual concurrency
  version Int @default(0)

  // Vault risk score snapshot at time of staking (1-10)
  vaultRiskScore Int? // 1 = safest, 10 = riskiest

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([userId, isActive])
  @@index([lastYieldAt]) // for yield cron job
}

// ---------------------------------------------------------------------------
// DEPOSIT ADDRESS — P2P Ledger generated addresses per user per asset
// ---------------------------------------------------------------------------

model DepositAddress {
  id          String @id @default(cuid())
  userId      String
  address     String   @unique // Base address to receive funds (HD derived)
  assetSymbol String
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  detectedAt  DateTime? // when Alchemy webhook fired for this address

  user User @relation(fields: [userId], references: [id])

  @@index([userId, used])
  @@index([address])
}

// ---------------------------------------------------------------------------
// PRICE CACHE — Layer 2 DB cache for crypto prices
// Prevents CoinGecko rate-limit exhaustion across server restarts
// ---------------------------------------------------------------------------

model PriceCache {
  id       String @id @default(cuid())
  coinId   String @unique // CoinGecko coin ID e.g. "ethereum"
  symbol   String         // "ETH"
  priceCents BigInt       // USD-cents (multiply by 0.01 for USD display)

  marketCapCents BigInt?
  volume24hCents BigInt?
  change24hBps   Int?    // 24h price change in basis points

  isStale   Boolean  @default(false)
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([symbol])
  @@index([fetchedAt])
}

// ---------------------------------------------------------------------------
// GAMIFICATION — XP, Badges, Daily Streaks
// ---------------------------------------------------------------------------

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  badge     BadgeType
  earnedAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, badge]) // each badge earned once
  @@index([userId])
}

model DailyStreak {
  id            String   @id @default(cuid())
  userId        String
  currentStreak Int      @default(0)  // consecutive days checked
  longestStreak Int      @default(0)
  lastCheckIn   DateTime @default(now())
  streakStarted DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId]) // one streak record per user
}

// ---------------------------------------------------------------------------
// AI PORTFOLIO AGENT — Smart Alerts (Professional Banker personality)
// ---------------------------------------------------------------------------

model AIAlert {
  id          String    @id @default(cuid())
  userId      String
  type        AlertType
  title       String    // e.g. "Yield Opportunity: ETH Vault B"
  message     String    // e.g. "Your ETH vault yields 4.8%. Vault B offers 7.2%..."
  actionUrl   String?   // deep link e.g. "/dashboard/vaults"
  isRead      Boolean   @default(false)
  isDismissed Boolean   @default(false)
  metadata    Json?     // extra context (vaultIds, amounts, etc.)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// VAULT RISK SCORE — Smart Security Scanner
// ---------------------------------------------------------------------------

model VaultRiskScore {
  id             String   @id @default(cuid())
  vaultId        String   @unique // on-chain vault contract address
  assetSymbol    String
  riskScore      Int      // 1 (safest) to 10 (riskiest)
  auditStatus    String   // "audited", "partial", "unaudited"
  auditor        String?  // e.g. "Certik", "OpenZeppelin"
  liquidityDepth BigInt   // USD-cents of total liquidity
  tvlCents       BigInt   // total value locked in cents
  impermanentLossRisk Int @default(0) // 0-10
  smartContractAge    Int @default(0) // days since deployment
  stabilityGrade      String?         // e.g. "AAA", "A+" for RWA
  lastUpdated    DateTime @default(now())

  @@index([riskScore])
  @@index([vaultId])
}

// ---------------------------------------------------------------------------
// SWAP ENGINE — Token conversion records
// ---------------------------------------------------------------------------

model SwapRecord {
  id             String   @id @default(cuid())
  userId         String
  fromAsset      String   // e.g. "ETH"
  toAsset        String   // e.g. "USDC"
  fromAmount     Decimal  @db.Decimal(28, 18)
  toAmount       Decimal  @db.Decimal(28, 18)
  fromAmountCents BigInt  // USD value at time of swap
  toAmountCents  BigInt
  exchangeRate   Decimal  @db.Decimal(20, 8)
  txHash         String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// USER PROFILE — Extended profile linked to wallet address
// Stores gamification metadata, preferences, and achievements
// ---------------------------------------------------------------------------

model UserProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  xp            Int      @default(0)
  level         Int      @default(1)
  badges        String[] // array of badge names earned
  title         String?  // display title e.g. "Yield Hunter"
  avatarSeed    String?  // deterministic avatar seed
  preferences   Json?    // user preferences (theme, notifications, etc.)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([level])
}

// ---------------------------------------------------------------------------
// TIERED REFERRAL — Yield-share tracking
// Tier 1: Direct referral (earn % of friend's yield)
// Tier 2: Friend-of-friend (earn smaller % of their yield)
// ---------------------------------------------------------------------------

model ReferralEarning {
  id              String   @id @default(cuid())
  earnerId        String   // user receiving the referral bonus
  sourceId        String   // user whose yield generated the bonus
  tier            Int      // 1 = direct, 2 = friend-of-friend
  yieldBasisBps   Int      // % of source yield earned (e.g. 500 = 5%)
  amountCents     BigInt   // actual bonus amount in cents
  sourceYieldCents BigInt  // the yield event that triggered this
  periodStart     DateTime // accrual period start
  periodEnd       DateTime
  paidOut         Boolean  @default(false)
  createdAt       DateTime @default(now())

  earner User @relation("ReferralEarner", fields: [earnerId], references: [id])
  source User @relation("ReferralSource", fields: [sourceId], references: [id])

  @@index([earnerId, paidOut])
  @@index([sourceId])
}

// ---------------------------------------------------------------------------
// PHASE 8: SOVEREIGN STATE — Launchpad, Governance, Treasury
// ---------------------------------------------------------------------------

enum ProposalStatus {
  ACTIVE
  PASSED
  REJECTED
  EXECUTED
}

enum VoteChoice {
  FOR
  AGAINST
  ABSTAIN
}

// Community Treasury — funded by 0.1% of every Convert fee
model Treasury {
  id              String   @id @default(cuid())
  totalBalanceCents BigInt @default(0) // total treasury balance in cents
  totalInflowCents  BigInt @default(0) // lifetime inflows
  totalOutflowCents BigInt @default(0) // lifetime outflows (proposal payouts)
  lastUpdated     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Treasury inflow/outflow ledger
model TreasuryTransaction {
  id          String   @id @default(cuid())
  amountCents BigInt
  type        String   // "SWAP_FEE", "PROPOSAL_PAYOUT"
  description String?
  swapRecordId String? // link to swap that generated the fee
  proposalId  String?  // link to proposal that triggered payout
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
}

// Governance Proposal
model Proposal {
  id              String         @id @default(cuid())
  creatorId       String
  creator         User           @relation("ProposalCreator", fields: [creatorId], references: [id])
  title           String
  description     String
  requestedCents  BigInt         @default(0) // treasury funds requested
  status          ProposalStatus @default(ACTIVE)
  votesFor        BigInt         @default(0) // weighted vote power
  votesAgainst    BigInt         @default(0)
  votesAbstain    BigInt         @default(0)
  totalVoters     Int            @default(0)
  quorumRequired  BigInt         @default(100000) // minimum vote power needed
  endsAt          DateTime       // voting deadline
  executedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  votes Vote[]

  @@index([status, endsAt])
  @@index([creatorId])
}

// Individual vote on a proposal — weighted by balance * XP
model Vote {
  id          String     @id @default(cuid())
  proposalId  String
  proposal    Proposal   @relation(fields: [proposalId], references: [id])
  voterId     String
  voter       User       @relation("Voter", fields: [voterId], references: [id])
  choice      VoteChoice
  votePower   BigInt     // balance_cents * sqrt(xp) — weighted voting
  createdAt   DateTime   @default(now())

  @@unique([proposalId, voterId]) // one vote per proposal per user
  @@index([proposalId])
  @@index([voterId])
}

// Launchpad Project — community-funded token launches
model LaunchpadProject {
  id              String   @id @default(cuid())
  name            String
  ticker          String   // e.g. "APEX"
  description     String
  targetCents     BigInt   // fundraising target
  raisedCents     BigInt   @default(0)
  minContribCents BigInt   @default(1000) // $10 minimum
  maxContribCents BigInt   @default(10000000) // $100k maximum
  tokenPrice      String   // display price e.g. "$0.01"
  totalSupply     String   // e.g. "1,000,000,000"
  status          String   @default("ACTIVE") // ACTIVE, FUNDED, CLOSED
  startsAt        DateTime @default(now())
  endsAt          DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contributions LaunchpadContribution[]

  @@index([status, endsAt])
}

// Individual contribution to a launchpad project
model LaunchpadContribution {
  id          String   @id @default(cuid())
  projectId   String
  project     LaunchpadProject @relation(fields: [projectId], references: [id])
  userId      String
  user        User     @relation("LaunchpadContributor", fields: [userId], references: [id])
  amountCents BigInt
  createdAt   DateTime @default(now())

  @@unique([projectId, userId]) // one contribution per user per project
  @@index([projectId])
  @@index([userId])
}
