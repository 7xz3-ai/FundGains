# ApexYield Anonymous — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, Railway, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/apexdb"

# ─── Alchemy ────────────────────────────────────────────────
# API key for on-chain data (Base mainnet)
ALCHEMY_API_KEY="your_alchemy_api_key"

# HMAC signing key for Alchemy webhook verification
# Found in Alchemy dashboard → Webhooks → signing key
ALCHEMY_SIGNING_KEY="your_alchemy_signing_key"

# ─── WalletConnect ──────────────────────────────────────────
# Project ID from cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id"

# ─── P2P Deposit Wallet ─────────────────────────────────────
# BIP-39 mnemonic or hex seed for HD wallet derivation.
# Used server-side ONLY to generate per-user deposit addresses.
# NEVER expose this to the client. NEVER commit this value.
DEPOSIT_WALLET_SEED="your_hd_wallet_master_seed_hex"

# ─── CoinGecko ──────────────────────────────────────────────
# Optional: CoinGecko API key for higher rate limits (free tier = 50 req/min)
COINGECKO_API_KEY=""

# ─── Cron Security ──────────────────────────────────────────
# Secret header value for the /api/cron/cleanup endpoint
CRON_SECRET="your_random_cron_secret"

# ─── Feature Flags ──────────────────────────────────────────
# Set to "true" to show Base Sepolia testnet in wallet selector
NEXT_PUBLIC_ENABLE_TESTNETS="false"

# ─── Environment ────────────────────────────────────────────
NODE_ENV="development"
